{
  // One Worker serves the built React app (static assets) and the Hono API under /api.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balikgamit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // React Router handles page URLs in the browser.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker code; everything else is a static file.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "SUPABASE_URL": "https://YOUR-PROJECT.supabase.co"
  },
  // Cron: keep-alive ping, report expiry sweep, reminders, AI job retries.
  "triggers": { "crons": ["0 3 */3 * *", "0 * * * *"] }
}
