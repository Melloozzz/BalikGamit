{
  // One Worker serves the built React app (static assets) and the Hono API under /api.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balikgamit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // React Router handles page URLs in the browser.
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker code; everything else is a static file.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "SUPABASE_URL": "https://tifeckfqokdktspjokqm.supabase.co"
  },
  // Cron (proposal: Cloudflare Cron Trigger): every 3 days keep Supabase awake and purge old records;
  // hourly expiry sweeps and reminders; every 5 minutes AI jobs and message emails.
  // Secrets (wrangler secret put): SUPABASE_SERVICE_ROLE_KEY, GROQ_API_KEY, and optionally RESEND_API_KEY.
  // EMAIL_FROM (e.g. "BalikGamit <no-reply@your-domain>") can be a var or a secret.
  "triggers": { "crons": ["0 3 */3 * *", "0 * * * *", "*/5 * * * *"] }
}
