{
  // One Worker serves the built React app (static assets) and the Hono API under /api.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "balikgamit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // No *.workers.dev address or preview links: the team uses dev.balikgamit.site behind
  // Cloudflare Access, the public uses balikgamit.site.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router handles page URLs in the browser.
    "not_found_handling": "single-page-application",
    // Every request reaches the Worker code first so the coming-soon gate can answer it
    // (worker/comingSoon.ts); the Worker then hands non-API requests to the static files.
    "run_worker_first": true
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "SUPABASE_URL": "https://tifeckfqokdktspjokqm.supabase.co",
    // "true": balikgamit.site shows the under-construction page; dev.balikgamit.site (team,
    // behind Cloudflare Access) and local dev stay open. Set to "false" and deploy to launch.
    "COMING_SOON": "true"
  },
  // Cron (proposal: Cloudflare Cron Trigger): every 3 days keep Supabase awake and purge old records;
  // hourly expiry sweeps and reminders; every 5 minutes AI jobs and message emails.
  // Secrets (wrangler secret put): SUPABASE_SERVICE_ROLE_KEY, GROQ_API_KEY, and optionally RESEND_API_KEY.
  // EMAIL_FROM (e.g. "BalikGamit <no-reply@your-domain>") can be a var or a secret.
  "triggers": { "crons": ["0 3 */3 * *", "0 * * * *", "*/5 * * * *"] }
}
